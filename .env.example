# Copiá este archivo a .env y completá los valores. No commitees .env.
# App (públicas: se incluyen en el bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Las claves del servidor (SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, ANTHROPIC_MODEL,
# REVENUECAT_SECRET_KEY) van como secretos de las Edge Functions: `npx supabase secrets set ...`.
# No las pongas en este archivo.
