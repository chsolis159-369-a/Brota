{
  "expo": {
    "name": "BROTA",
    "slug": "brota",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brota",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.brota.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.brota.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A4A33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A4A33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B2318"
          }
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BROTA usa tu ubicación aproximada para mostrar el pronóstico del clima de tu zona."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BROTA usa tus fotos para que sigas la evolución de tus cultivos.",
          "cameraPermission": "BROTA usa la cámara para que saques fotos de tus plantas, hojas, plagas o insectos y el guía las analice.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
